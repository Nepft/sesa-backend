# Salin berkas ini menjadi `.env` lalu isi nilainya sesuai kebutuhan.
# Jangan pernah commit `.env` berisi nilai asli ke repository.

# (Opsional) Lokasi alternatif berkas .env. Dibaca dari environment proses,
# bukan dari .env itu sendiri. Bila tidak diset, memakai .env di root repo.
# SESA_ENV_FILE=/path/ke/.env

# Path artefak model final (bundle joblib dari Colab)
MODEL_PATH=model/sesa_model.joblib

# Batas unggahan CSV
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_CSV_ROWS=5000

# Nama kolom teks pada file CSV batch
CSV_TEXT_COLUMN=content

# Asal (origin) yang diizinkan mengakses API, dipisah koma.
# Jangan pakai wildcard (*) di produksi.
CORS_ORIGINS=["http://localhost:5173"]

# Tingkat log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
